-            <div>
-              <h2 class="font-montserrat text-2xl md:text-xl font-bold text-white">Abogado Emmanuel Quiroz</h2>
-              <p class="text-blue-400 text-sm font-medium mt-1">Socio Cofundador</p>
-            </div>
-          </div>
